<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Luyện Dịch Tiếng Đức - Deutsch Übung App</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
    body { font-family: 'Inter', sans-serif; }
    @media print {
      .no-print { display: none !important; }
      .print-only { display: block !important; }
      .sentence-card { page-break-inside: avoid; border: 1px solid #ccc !important; box-shadow: none !important; }
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

  <header class="bg-indigo-700 text-white shadow-lg no-print">
    <div class="max-w-5xl mx-auto px-4 py-4 flex flex-wrap justify-between items-center gap-4">
      <div class="flex items-center space-x-3">
        <div class="bg-white text-indigo-700 p-2 rounded-lg font-bold text-xl shadow">DE</div>
        <div>
          <h1 class="font-bold text-xl tracking-wide">Luyện Dịch Tiếng Đức</h1>
          <p class="text-xs text-indigo-200">Công cụ hỗ trợ dịch dòng-cách-dòng & Kiểm tra AI</p>
        </div>
      </div>
      <div class="flex items-center space-x-2" id="headerActions">
        <button id="resetBtnHeader" onclick="confirmReset()" class="hidden bg-rose-600 hover:bg-rose-700 text-white text-xs md:text-sm px-3 py-2 rounded-lg transition font-medium flex items-center gap-2 shadow">
          <i class="fa-solid fa-rotate-right"></i>
          <span>Làm mới / Bài mới</span>
        </button>
      </div>
    </div>
  </header>

  <main class="flex-1 max-w-5xl w-full mx-auto p-4 md:p-6">
    <div id="stepInput" class="space-y-6">
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
        <div class="flex justify-between items-center mb-4">
          <label class="block text-sm font-semibold text-slate-700 flex items-center gap-2">
            <i class="fa-solid fa-file-lines text-indigo-600"></i>
            Dán hoặc tải bài văn tiếng Đức tại đây:
          </label>
          <div class="flex items-center gap-2">
            <button onclick="loadSampleText()" class="text-xs bg-indigo-50 text-indigo-600 px-3 py-1.5 rounded-lg hover:bg-indigo-100 font-medium transition">
              <i class="fa-solid fa-wand-magic-sparkles mr-1"></i> Tải bài mẫu
            </button>
            <button onclick="clearInputText()" class="text-xs bg-slate-100 text-slate-600 px-3 py-1.5 rounded-lg hover:bg-slate-200 font-medium transition">
              <i class="fa-solid fa-trash-can mr-1"></i> Xóa
            </button>
          </div>
        </div>

        <textarea id="rawGermanText" rows="10" placeholder="Ví dụ: Hallo! Wie geht es dir heute? Ich lerne seit drei Monaten Deutsch. Es macht wirklich Spaß..." class="w-full p-4 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none resize-y text-slate-700 text-base leading-relaxed mb-4"></textarea>

        <div class="flex flex-wrap items-center justify-between gap-4 border-t border-slate-100 pt-4">
          <div class="flex items-center gap-3">
            <label class="cursor-pointer bg-slate-100 hover:bg-slate-200 text-slate-700 px-4 py-2 rounded-xl text-sm font-medium transition flex items-center gap-2 border border-slate-200">
              <i class="fa-solid fa-upload text-indigo-600"></i>
              <span>Tải file .txt</span>
              <input type="file" id="fileInput" accept=".txt" class="hidden" onchange="handleFileUpload(event)">
            </label>
            <span id="fileName" class="text-xs text-slate-500 italic"></span>
          </div>

          <button onclick="processText()" class="w-full sm:w-auto bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-8 py-3 rounded-xl shadow-md hover:shadow-lg transition flex items-center justify-center gap-2 text-base">
            <span>Bắt đầu luyện dịch</span>
            <i class="fa-solid fa-arrow-right"></i>
          </button>
        </div>
      </div>
    </div>

    <div id="stepPractice" class="hidden space-y-6">
      <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex flex-wrap justify-between items-center gap-3 no-print">
        <div class="flex items-center gap-2">
          <span class="text-xs font-semibold uppercase tracking-wider bg-indigo-100 text-indigo-700 px-2.5 py-1 rounded-md">Bài tập dịch</span>
          <span id="sentenceCount" class="text-xs font-medium text-slate-500"></span>
        </div>
        
        <div class="flex items-center flex-wrap gap-2">
          <button onclick="checkAllSentences()" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs px-3 py-2 rounded-lg font-medium transition flex items-center gap-1.5 shadow-sm">
            <i class="fa-solid fa-robot"></i>
            <span>AI Kiểm Tra Tất Cả</span>
          </button>
          <button onclick="copyBilingualText()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs px-3 py-2 rounded-lg font-medium transition flex items-center gap-1.5">
            <i class="fa-regular fa-copy"></i>
            <span>Sao chép bài dịch</span>
          </button>
          <button onclick="downloadTranslation()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs px-3 py-2 rounded-lg font-medium transition flex items-center gap-1.5">
            <i class="fa-solid fa-download"></i>
            <span>Xuất file .txt</span>
          </button>
          <button onclick="window.print()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs px-3 py-2 rounded-lg font-medium transition flex items-center gap-1.5">
            <i class="fa-solid fa-print"></i>
            <span>In / PDF</span>
          </button>
          <button onclick="confirmReset()" class="bg-rose-100 hover:bg-rose-200 text-rose-700 text-xs px-3 py-2 rounded-lg font-medium transition flex items-center gap-1.5">
            <i class="fa-solid fa-rotate-right"></i>
            <span>Bài mới</span>
          </button>
        </div>
      </div>

      <div id="sentencesList" class="space-y-4"></div>
    </div>
  </main>

  <script>
    let sentencesData = [];

    window.onload = function() {
      const savedData = localStorage.getItem('de_vi_practice_data');
      if (savedData) {
        try {
          sentencesData = JSON.parse(savedData);
          if (sentencesData.length > 0) renderSentences();
        } catch (e) { console.error(e); }
      }
    };

    function saveData() {
      localStorage.setItem('de_vi_practice_data', JSON.stringify(sentencesData));
    }

    function clearInputText() {
      document.getElementById('rawGermanText').value = '';
    }

    function loadSampleText() {
      document.getElementById('rawGermanText').value = 
        "Hallo! Wie geht es dir heute?\n" +
        "Ich heiße Anna und komme aus Deutschland.\n" +
        "Deutsch lernen ist nicht so schwer, wenn man jeden Tag übt.\n" +
        "Haben Sie Fragen an mich?";
    }

    function handleFileUpload(event) {
      const file = event.target.files[0];
      if (!file) return;
      document.getElementById('fileName').innerText = file.name;
      const reader = new FileReader();
      reader.onload = function(e) {
        document.getElementById('rawGermanText').value = e.target.result;
      };
      reader.readAsText(file);
    }

    function splitGermanSentences(text) {
      if (!text) return [];
      const cleaned = text.replace(/\r\n/g, '\n');
      const rawSentences = cleaned.split(/(?<=[.!?])\s+|\n+/);
      return rawSentences
        .map(s => s.trim())
        .filter(s => s.length > 0)
        .map(s => ({
          german: s,
          vietnamese: '',
          aiFeedback: null
        }));
    }

    function processText() {
      const rawText = document.getElementById('rawGermanText').value;
      if (!rawText.trim()) {
        alert("Vui lòng dán hoặc nhập văn bản tiếng Đức!");
        return;
      }
      sentencesData = splitGermanSentences(rawText);
      saveData();
      renderSentences();
    }

    function renderSentences() {
      const container = document.getElementById('sentencesList');
      container.innerHTML = '';

      if (sentencesData.length === 0) return;

      document.getElementById('stepInput').classList.add('hidden');
      document.getElementById('stepPractice').classList.remove('hidden');
      document.getElementById('resetBtnHeader').classList.remove('hidden');
      document.getElementById('sentenceCount').innerText = `${sentencesData.length} câu`;

      sentencesData.forEach((item, index) => {
        const card = document.createElement('div');
        card.className = "sentence-card bg-white rounded-xl p-5 shadow-sm border border-slate-200 transition space-y-3";

        let feedbackHTML = '';
        if (item.aiFeedback) {
          feedbackHTML = `
            <div class="mt-3 p-3.5 bg-slate-50 border border-slate-200 rounded-lg text-xs md:text-sm space-y-2">
              <div class="flex items-center gap-2 font-semibold text-indigo-700">
                <i class="fa-solid fa-lightbulb"></i> Phản hồi từ AI:
              </div>
              <div class="text-slate-700"><strong>Gợi ý dịch:</strong> <span class="text-emerald-700 font-medium">${item.aiFeedback.suggestion}</span></div>
              ${item.aiFeedback.notes ? `<div class="text-slate-600 bg-white p-2.5 rounded border border-slate-100"><strong>Nhận xét/Lỗi sai:</strong> ${item.aiFeedback.notes}</div>` : ''}
            </div>
          `;
        }

        card.innerHTML = `
          <div class="flex items-start justify-between gap-3">
            <div class="flex items-center gap-2">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-indigo-100 text-indigo-700 text-xs font-bold flex items-center justify-center">${index + 1}</span>
              <div contenteditable="true" 
                   onblur="updateGerman(${index}, this.innerText)" 
                   class="text-slate-800 font-semibold text-base md:text-lg focus:outline-none focus:bg-amber-50 p-1 rounded transition border border-transparent hover:border-slate-200">${item.german}</div>
            </div>
            <div class="flex items-center gap-1 no-print">
              <button onclick="speakText('${encodeURIComponent(item.german)}')" class="text-slate-400 hover:text-indigo-600 p-1.5 rounded-lg transition" title="Nghe phát âm">
                <i class="fa-solid fa-volume-high"></i>
              </button>
              <button id="btn-check-${index}" onclick="checkSingleSentence(${index})" class="text-xs bg-teal-50 hover:bg-teal-100 text-teal-700 px-2.5 py-1.5 rounded-lg font-medium transition flex items-center gap-1">
                <i class="fa-solid fa-circle-check"></i>
                <span>Kiểm tra</span>
              </button>
            </div>
          </div>

          <div class="pl-8">
            <input type="text" 
                   value="${item.vietnamese || ''}" 
                   oninput="updateVietnamese(${index}, this.value)" 
                   placeholder="Nhập bản dịch tiếng Việt của bạn..." 
                   class="w-full p-3 border border-slate-200 rounded-lg text-slate-700 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none text-sm md:text-base">
            ${feedbackHTML}
          </div>
        `;
        container.appendChild(card);
      });
    }

    function updateGerman(index, val) {
      sentencesData[index].german = val.trim();
      saveData();
    }

    function updateVietnamese(index, val) {
      sentencesData[index].vietnamese = val;
      saveData();
    }

    function speakText(encodedText) {
      const text = decodeURIComponent(encodedText);
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = 'de-DE';
      window.speechSynthesis.speak(utterance);
    }

    async function checkSingleSentence(index) {
      const item = sentencesData[index];
      if (!item.vietnamese || !item.vietnamese.trim()) {
        alert("Vui lòng nhập bản dịch tiếng Việt trước khi kiểm tra!");
        return;
      }

      const btn = document.getElementById(`btn-check-${index}`);
      if (btn) btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Checking...`;

      try {
        const prompt = `Bạn là một giáo viên tiếng Đức. Hãy đánh giá bản dịch tiếng Việt sau đây cho câu tiếng Đức:
Câu gốc: "${item.german}"
Bản dịch của người học: "${item.vietnamese}"

Hãy trả về định dạng JSON thuần túy (không chứa markdown triple backticks) với cấu trúc sau:
{
  "suggestion": "Bản dịch tiếng Việt gợi ý chuẩn xác và tự nhiên nhất",
  "notes": "Nhận xét chi tiết về lỗi sai ngữ pháp, từ vựng hoặc cách cải thiện (viết bằng tiếng Việt, ngắn gọn dễ hiểu)"
}`;

        const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=YOUR_API_KEY`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }] })
        });

        const data = await response.json();
        let resText = data.candidates[0].content.parts[0].text;
        resText = resText.replace(/```json/g, '').replace(/```/g, '').trim();
        const parsed = JSON.parse(resText);

        sentencesData[index].aiFeedback = parsed;
        saveData();
        renderSentences();
      } catch (err) {
        console.error(err);
        sentencesData[index].aiFeedback = {
          suggestion: "Không thể gọi AI trực tiếp mà không có API Key.",
          notes: "Gợi ý: Hãy thêm API Key của bạn vào mã nguồn hoặc kiểm tra kết nối mạng."
        };
        renderSentences();
      }
    }

    async function checkAllSentences() {
      for (let i = 0; i < sentencesData.length; i++) {
        if (sentencesData[i].vietnamese && sentencesData[i].vietnamese.trim()) {
          await checkSingleSentence(i);
        }
      }
    }

    function copyBilingualText() {
      let text = "";
      sentencesData.forEach((item, idx) => {
        text += `${idx + 1}. ${item.german}\n   ${item.vietnamese || '[Chưa dịch]'}\n\n`;
      });
      navigator.clipboard.writeText(text).then(() => {
        alert("Đã sao chép toàn bộ bài dịch song ngữ vào bộ nhớ tạm!");
      });
    }

    function downloadTranslation() {
      let text = "";
      sentencesData.forEach((item, idx) => {
        text += `${idx + 1}. ${item.german}\n   ${item.vietnamese || ''}\n\n`;
      });
      const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'Bai_Luyen_Dich_Tieng_Duc.txt';
      a.click();
    }

    function confirmReset() {
      if (confirm("Bạn có chắc chắn muốn xóa bài hiện tại và bắt đầu bài mới? Tất cả tiến trình sẽ được làm mới.")) {
        localStorage.removeItem('de_vi_practice_data');
        sentencesData = [];
        document.getElementById('stepPractice').classList.add('hidden');
        document.getElementById('stepInput').classList.remove('hidden');
        document.getElementById('resetBtnHeader').classList.add('hidden');
        document.getElementById('rawGermanText').value = '';
      }
    }
  </script>
</body>
</html>
